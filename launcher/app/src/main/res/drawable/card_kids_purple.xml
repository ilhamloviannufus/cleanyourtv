<?xml version="1.0" encoding="utf-8"?>
<!-- Kids-game "candy" card: same bold-colour, bottom-bevel treatment as pill_candy_*, used for the
     next-match/standings panel instead of the earlier frosted glass_panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4B32A6" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF6C4FD1" />
            <stroke android:width="1.5dp" android:color="#33FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
