<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit at weight 700: the kids-style candy pills (pill_candy_*) want a chunkier label than
     outfit_medium gives. Same variable font file, so this costs no extra bytes in the APK. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/outfit"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        tools:targetApi="28" />
</font-family>
